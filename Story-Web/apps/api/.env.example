# ==========================================
# CẤU HÌNH FASTAPI BACKEND (.env.local)
# ==========================================

# 1. SERVER CONFIG
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=tobe_replaced_in_production

# 2. CLERK AUTHENTICATION (Lấy từ Dashboard Clerk)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# 3. DATABASE: POSTGRESQL (Nối vào cổng lộ ra từ Docker localhost:5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/story_db

# 4. DATABASE: VECTOR QDRANT (Nối vào cổng localhost:6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 5. DATABASE: GRAPH NEO4J (Nối vào chuẩn Bolt localhost:7687)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# 6. REDIS / CELERY
REDIS_URL=redis://localhost:6379/0

# 7. AI LOCAL MODELS (OLLAMA ENDPOINTS)
# Sinh văn bản (Trái tim Logic)
OLLAMA_GEN_HOST=http://localhost:11434
OLLAMA_MODEL_GEN=gpt-oss:120b-cloud

# Embeddings Vector
OLLAMA_EMBED_HOST=http://222.253.80.30:11434/api/embeddings
OLLAMA_MODEL_EMBED=bge-m3:567m
