# ─────────────────────────────────────────────────────────────────────────────
# Story AI Platform — Production Environment Variables
# Copy file này thành .env và điền các giá trị thực
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk Auth ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxx

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=story_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=story_db

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_password

# ── AI (Ollama) ───────────────────────────────────────────────────────────────
# Gen model — server chạy Ollama (có thể là IP ngoài hoặc host.docker.internal)
OLLAMA_GEN_HOST=http://222.253.80.30:11434
OLLAMA_MODEL_GEN=gpt-oss:120b-cloud

# Embed model
OLLAMA_EMBED_HOST=http://222.253.80.30:11434/api/embeddings
OLLAMA_MODEL_EMBED=bge-m3:567m
